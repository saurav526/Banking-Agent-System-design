# ---- LLM selection: mock | self_hosted | third_party ----
LLM_DEFAULT_PROVIDER=mock
ROUTE_SENSITIVE_TO_SELF_HOSTED=true

# Self-hosted LLM (Ollama / vLLM / TGI - OpenAI-compatible /v1)
SELF_HOSTED_BASE_URL=http://localhost:11434/v1
SELF_HOSTED_MODEL=llama3.1:8b
SELF_HOSTED_API_KEY=ollama

# Third-party LLM (OpenAI or compatible gateway)
OPENAI_API_KEY=
THIRD_PARTY_MODEL=gpt-4o-mini
# THIRD_PARTY_BASE_URL=https://your-gateway/v1

# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-secret
MCP_SHARED_SECRET=change-me-too
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
MAX_BODY_BYTES=16384

# ---- MCP servers: "inprocess" or URL of the standalone server ----
ACCOUNTS_MCP_URL=inprocess
TRANSACTIONS_MCP_URL=inprocess
SERVICE_MCP_URL=inprocess

# ---- Cost ----
SESSION_BUDGET_USD=0.50
USE_TIKTOKEN=0

# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# This template defines default runtime settings, credentials, endpoints,
# and operational thresholds for the multi-agent banking system.
#
# Copy this file to '.env' and populate sensitive credentials prior to running:
#   $ cp .env.example .env
#
# Configuration Categories:
# -------------------------
# 1. LLM Provider & Routing Strategy:
#    - Select default backend: deterministic offline mock, local OpenAI-compatible
#      engine (vLLM / Ollama), or frontier third-party API (OpenAI).
#    - Enforces tenant privacy rules (e.g. routing sensitive turns to self-hosted LLMs).
#
# 2. Ingress Security & Perimeter Defenses:
#    - Cryptographic secrets for JWT session tokens and MCP microservice communication.
#    - Volumetric rate limits (sustained per-minute and burst capacity) and body size caps.
#
# 3. Model Context Protocol (MCP) Service Topology:
#    - Targets for domain tools (accounts, transactions, service verticals).
#    - Supports local in-process dispatch ("inprocess") or remote HTTP URLs (:8101-:8103).
#
# 4. Cost Governance & Token Accounting:
#    - Per-session spending budgets (USD) to safeguard against runaway loops.
#    - Optional high-precision BPE token estimation via tiktoken.
# ==============================================================================
